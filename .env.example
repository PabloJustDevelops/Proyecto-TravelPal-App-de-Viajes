NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo servidor (no exponer en cliente)
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Nivel de logs (debug|info|warn|error). Recomendado: info (preview), warn (producción)
NEXT_PUBLIC_LOG_LEVEL=info

# Configuración del LLM (Opcional si se usan valores por defecto)
# NEXT_PUBLIC_LLM_MODEL=mixtral-8x7b-32768

# Amadeus (opcional)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
