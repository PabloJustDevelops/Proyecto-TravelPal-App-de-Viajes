# ============================================================================
# App Viajes - Plantilla de variables de entorno
# Copia este archivo a .env.local y rellena los valores que necesites.
# .env.local NUNCA se versiona (ver .gitignore).
# ============================================================================

# --- InsForge (obligatorias) ------------------------------------------------
# Base URL del proyecto y anon key pública. El prefijo NEXT_PUBLIC_ hace que
# Next.js las inyecte en el bundle del navegador: son públicas por diseño.
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# --- Supabase (obligatorias, en retirada) -----------------------------------
# TEMPORAL: sólo alimenta la auth de cliente que aún no se ha migrado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sólo servidor: NO exponer nunca en el cliente ---------------------------
# API key de proyecto de InsForge (acceso total, salta RLS). Sin prefijo
# NEXT_PUBLIC_ a propósito: Next.js nunca la envía al navegador.
INSFORGE_API_KEY=

# Service role key de Supabase (en retirada junto con su auth).
SUPABASE_SERVICE_ROLE_KEY=

# --- Logging (opcional) ------------------------------------------------------
# Nivel de logs: debug | info | warn | error.
# Por defecto: info en desarrollo, warn en producción.
NEXT_PUBLIC_LOG_LEVEL=info

# URL pública de la app (se usa como HTTP-Referer hacia OpenRouter). Opcional.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Proveedores LLM (opcionales) --------------------------------------------
# Sin OPENROUTER_API_KEY/GROQ_API_KEY el endpoint de chat responde 503.
OPENROUTER_API_KEY=
# GROQ_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Ajustes finos del LLM (NEXT_PUBLIC_ => visibles en el cliente). Opcionales.
# NEXT_PUBLIC_LLM_MODEL=
# NEXT_PUBLIC_LLM_TEMPERATURE=0.7
# NEXT_PUBLIC_LLM_MAX_TOKENS=1000
# NEXT_PUBLIC_LLM_TIMEOUT=30000

# --- Amadeus (opcional) ------------------------------------------------------
# Sin credenciales la búsqueda de vuelos falla. Se admiten dos convenciones.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# AMADEUS_API_KEY=
# AMADEUS_API_SECRET=
# AMADEUS_API_HOST=https://test.api.amadeus.com
